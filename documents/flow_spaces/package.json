{
  "name": "flow-spaces",
  "version": "0.1.0",
  "private": true,
  "description": "Flow Spaces — workflow visual editor & mini-apps, migrated from agent-spaces (Next.js) to Vite + React 19",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "protobufjs"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @flow-spaces/web dev",
    "build": "pnpm build:packages && pnpm --filter @flow-spaces/web build",
    "preview": "pnpm --filter @flow-spaces/web preview",
    "typecheck": "pnpm --filter @flow-spaces/web typecheck",
    "build:packages": "pnpm --filter @agent-spaces/shared build && pnpm --filter @agent-spaces/sdk build",
    "dev:server": "pnpm --filter @agent-spaces/server dev",
    "dev:all": "pnpm build:packages && pnpm dev:server & pnpm dev"
  }
}
