# SAM segmentation server config — copy to sam_server/.env and edit.
# Never commit sam_server/.env (it holds paths to private checkpoints).

# Which segmentation backend to use:
#   sam2    Meta SAM2 (recommended, best quality; needs torch + sam2 pkg)
#   sam     Original Segment Anything (needs torch + segment-anything pkg)
#   opencv  GrabCut fallback, no ML model — works without torch/checkpoints
SAM_BACKEND=opencv

# ─── SAM2 backend ──────────────────────────────────────────────────────────
# Download from https://github.com/facebookresearch/sam2#segment-anything-2-1
SAM2_CHECKPOINT=checkpoints/sam2.1_hiera_tiny.pt
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml

# ─── Original SAM backend ──────────────────────────────────────────────────
# https://github.com/facebookresearch/segment-anything#model-checkpoints
SAM_CHECKPOINT=checkpoints/sam_vit_h_4b8939.pth
SAM_MODEL_TYPE=vit_h

# ─── runtime ───────────────────────────────────────────────────────────────
# cuda | cpu | mps
SAM_DEVICE=cpu
SAM_HOST=0.0.0.0
SAM_PORT=30231
