{
  "name": "@agent-spaces/mcp",
  "version": "0.1.0",
  "description": "把 @agent-spaces/sdk 的全部能力暴露为 MCP（Model Context Protocol）服务，支持 stdio / http 双 transport。",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "agent-spaces-mcp": "./dist/src/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/fix-esm-extensions.mjs",
