    "test": "node scripts/run-redlight.mjs"
  },
  "dependencies": {
    "@agent-spaces/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
