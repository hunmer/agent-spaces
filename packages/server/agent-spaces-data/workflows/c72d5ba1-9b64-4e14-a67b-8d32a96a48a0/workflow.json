    {
      "id": "node_1783938901671_8m73z0",
      "type": "run_code",
      "label": "生成文件名",
      "position": {
        "x": 1045,
        "y": 301.6875
      },
      "data": {
        "code": "async function main({ params }) {\n  const url = (params.item || '').toString();\n  let ext = '';\n  try {\n    const u = new URL(url);\n    const pathname = u.pathname || '';\n    const slashIdx = pathname.lastIndexOf('/');\n    const dotIdx = pathname.lastIndexOf('.');\n    if (dotIdx !== -1 && dotIdx > slashIdx) {\n      ext = pathname.substring(dotIdx);\n    }\n  } catch (e) {\n    const qIdx = url.indexOf('?');\n    const hashIdx = url.indexOf('#');\n    const cut = Math.min(\n      qIdx === -1 ? url.length : qIdx,\n      hashIdx === -1 ? url.length : hashIdx\n    );\n    const clean = url.substring(0, cut);\n    const slashIdx = clean.lastIndexOf('/');\n    const dotIdx = clean.lastIndexOf('.');\n    if (dotIdx !== -1 && dotIdx > slashIdx) {\n      ext = clean.substring(dotIdx);\n    }\n  }\n  if (!ext) ext = '.bin';\n  const random =\n    Math.random().toString(36).slice(2, 10) + Date.now().toString(36);\n  const key = `uploads/${random}${ext}`;\n  return { key, isHttp: url.startsWith('http') };\n}",
        "inputFields": [
          {
            "key": "item",
            "type": "string",
            "value": "{{ __loop__.item }}",
            "children": []
          }
        ],
