      },
      "data": {
        "code": "async function main({ params, context }) {\n  // 音频分支：透传 run_code 输出的 filePath\n  // 输出与 ffmpeg_demux 一致的结构 { data: { audioPath, videoPath } }\n  const filePath = params.filePath || '';\n  return {\n    data: {\n      audioPath: filePath,\n      videoPath: '',\n    },\n  };\n}",
