    {
      "id": "node_1781626091032_1o8ohj",
      "type": "run_code",
      "label": "合并URL",
      "position": {
        "x": 1500,
        "y": 90
      },
      "data": {
        "code": "async function main({ params, context }) {\n  // 从视频分支或音频分支的 cos_upload_file 中获取上传后的在线 URL\n  // 任意一个上游会发送数据（switch 只触发一个分支）\n  const url = params.videoUploadUrl || params.audioUploadUrl || '';\n  if (!url) {\n    return { fileUrls: [], fileUrl: '' };\n  }\n  return {\n    fileUrls: [url],\n    fileUrl: url,\n  };\n}",
        "inputFields": [
          {
            "key": "videoUploadUrl",
            "type": "string",
            "value": "{{ __data__[\"node_1781626078436_ml9abk\"].data.url }}"
          },
          {
            "key": "audioUploadUrl",
