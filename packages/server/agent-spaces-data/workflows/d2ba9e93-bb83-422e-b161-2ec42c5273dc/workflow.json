    {
      "id": "node_1781625972244_2qik8q",
      "type": "run_code",
      "label": "提取文件类型",
      "position": {
        "x": 300,
        "y": 90
      },
      "data": {
        "code": "async function main({ params, context }) {\n  // 从开始节点获取文件信息\n  const file = params.file;\n  if (!file) {\n    return { fileType: 'unknown', filePath: '', fileName: '', originalName: '' };\n  }\n  const fileName = file.name || file.originalName || '';\n  const filePath = file.path || file.url || file.localPath || '';\n  const ext = (fileName.split('.').pop() || '').toLowerCase();\n\n  // 视频后缀\n  const videoExts = ['mp4', 'mov', 'avi', 'mkv', 'flv', 'wmv', 'webm', 'm4v', 'ts', 'mpg', 'mpeg', '3gp', 'rm', 'rmvb'];\n  // 音频后缀\n  const audioExts = ['mp3', 'wav', 'aac', 'flac', 'ogg', 'm4a', 'wma', 'opus', 'amr', 'ac3'];\n\n  let fileType = 'unknown';\n  if (videoExts.includes(ext)) fileType = 'video';\n  else if (audioExts.includes(ext)) fileType = 'audio';\n\n  return {\n    fileType,\n    filePath,\n    fileName,\n    originalName: fileName,\n    ext,\n  };\n}",
        "inputFields": [
          {
            "key": "file",
            "type": "file",
            "value": "{{ __data__[\"node_1781611468547_start\"].file }}",
            "required": true
          }
        ],
        "outputs": [
          {
            "key": "fileType",
            "type": "string",
            "description": "文件类型：video / audio / unknown"
          },
          {
            "key": "filePath",
            "type": "string",
            "description": "本地文件路径"
          },
          {
            "key": "fileName",
            "type": "string",
            "description": "文件名"
          },
          {
            "key": "originalName",
            "type": "string",
            "description": "原始文件名"
          },
          {
            "key": "ext",
            "type": "string",
            "description": "文件后缀"
          }
        ]
      }
    },
