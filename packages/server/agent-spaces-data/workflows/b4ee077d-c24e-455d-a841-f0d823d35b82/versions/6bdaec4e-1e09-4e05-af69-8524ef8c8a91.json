        "data": {
          "code": "async function main({ params }) {\n    const ret = {\n      \"tracks\": [\n        {\n          \"id\": \"1\",\n          \"title\": \"背景音乐\",\n          \"type\": \"audio\"\n        },\n        {\n          \"id\": \"2\",\n          \"title\": \"视频\",\n          \"type\": \"video\"\n        },\n        {\n          \"id\": \"3\",\n          \"title\": \"配音\",\n          \"type\": \"audio\"\n        },\n        {\n          \"id\": \"4\",\n          \"title\": \"字幕\",\n          \"type\": \"text\"\n        }\n      ],\n      \"items\": []\n    }\n    const animations = ['缩放','向右缩放','向左缩放']\n    let start = 0\n    params.list.forEach(({duration, image, text, audio}, i) => {\n      if(duration <= 0) duration = 1\n      ret.items.push({\n        \"type\": \"image\",\n        \"data\": {\n          \"path\": image,\n          \"track\": \"2\",\n          \"start\": start,\n          \"duration\": duration,\n          \"animations\": {\n            \"name\": animations[i % animations.length],\n            \"duration\": duration\n          }\n        }\n      })\n      ret.items.push({\n        \"type\": \"subtitle\",\n        \"data\": {\n          \"text\": text,\n          \"track\": \"4\",\n          \"start\": start,\n          \"duration\": duration\n        }\n      })\n  \n      ret.items.push({\n        \"type\": \"vocal\",\n        \"data\": {\n          \"path\": audio,\n          \"track\": \"3\",\n          \"start\": start,\n          \"duration\": duration\n        }\n      })\n  \n      start += duration * 1\n    })\n    if(params.bgm != '') ret.items.push({\n      \"type\": \"music\",\n      \"data\": {\n        \"track\": \"1\",\n        \"path\": params.bgm,\n        \"start\": 0,\n        \"duration\": start\n      }\n    })\n  \n    return ret\n}",
