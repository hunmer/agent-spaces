    {
      "id": "node_1781714698009_vvhfrg",
      "type": "run_code",
      "label": "解析分镜 JSON",
      "position": {
        "x": 600,
        "y": 0
      },
      "data": {
        "code": "async function main({ params }) {\n  const raw = (params.agentResult || '').trim();\n  let scenes = [];\n  try {\n    const parsed = JSON.parse(raw);\n    if (Array.isArray(parsed)) {\n      scenes = parsed;\n    } else if (parsed && Array.isArray(parsed.scenes)) {\n      scenes = parsed.scenes;\n    } else if (parsed && Array.isArray(parsed.shots)) {\n      scenes = parsed.shots;\n    } else {\n      scenes = [parsed];\n    }\n  } catch (e) {\n    const match = raw.match(/\\[[\\s\\S]*\\]/);\n    if (match) {\n      try {\n        scenes = JSON.parse(match[0]);\n      } catch (e2) {\n        scenes = [];\n      }\n    }\n  }\n\n  const normalized = scenes.map((item, idx) => {\n    if (typeof item === 'string') {\n      return { index: idx + 1, prompt: item };\n    }\n    return {\n      index: item.index ?? idx + 1,\n      prompt: item.prompt || item.imagePrompt || item.description || item.shot || item.text || JSON.stringify(item),\n    };\n  });\n\n  return {\n    scenes: normalized,\n    count: normalized.length,\n  };\n}",
        "inputFields": [
          {
            "key": "agentResult",
            "type": "string",
            "value": "{{ __data__[\"node_1781714576999_ignsfm\"].result }}",
            "description": "分镜大师 Agent 的原始输出字符串",
            "required": true
          }
        ]
      },
