        "y": -60
      },
      "data": {
        "code": "async function main({ params }) {\n  let {images} = params\n  let media = [\n      {\n          \"type\": \"first_frame\",\n          \"url\": images[0]\n      }\n  ]\n  if(images.length > 1){\n    media.push({\n        \"type\": \"last_frame\",\n        \"url\": images[1]\n    })\n  }\n  return {media}\n}",
        "sourceNodeId": "node_1781686908308_6flfam",
        "sourceHandle": "case-1",
        "inputFields": [
          {
            "key": "images",
            "type": "string[]",
            "value": "{{ __data__[\"node_1781681576137_start\"].images }}",
            "required": true,
            "children": []
          }
        ],
        "outputs": [
