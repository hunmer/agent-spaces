      "data": {
        "code": "async function main({ params }) {\n  const { model } = params;\n  const jimengModels = [\n    'jimeng-video-3.5-pro',\n    'jimeng-video-3.0',\n    'jimeng-video-3.0-pro',\n    'jimeng-video-3.0-fast',\n    'jimeng-video-2.0',\n    'jimeng-video-2.0-pro'\n  ];\n  const minimaxModels = [\n    'MiniMax-Hailuo-2.3',\n    'MiniMax-Hailuo-2.3-Fast',\n    'MiniMax-Hailuo-02',\n    'I2V-01-Director',\n    'I2V-01-live',\n    'I2V-01'\n  ];\n  if (model && jimengModels.includes(model)) {\n    return { target: 'jimeng' };\n  } else if (model && minimaxModels.includes(model)) {\n    return { target: 'minimax' };\n  } else {\n    return { target: 'aliyun' };\n  }\n}",
