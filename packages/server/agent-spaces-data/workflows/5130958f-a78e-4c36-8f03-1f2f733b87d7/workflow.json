    {
      "id": "node_1782293130533_309iyn",
      "type": "run_code",
      "label": "模型路由判断",
      "position": {
        "x": 300,
        "y": 180
      },
      "data": {
        "code": "async function main({ params }) {\n  const { model } = params;\n  // 即梦支持的模型列表\n  const jimengModels = [\n    'jimeng-video-3.5-pro',\n    'jimeng-video-3.0',\n    'jimeng-video-3.0-pro',\n    'jimeng-video-3.0-fast',\n    'jimeng-video-2.0',\n    'jimeng-video-2.0-pro'\n  ];\n  // 判断是否为即梦模型\n  if (model && jimengModels.includes(model)) {\n    return { target: 'jimeng' };\n  } else {\n    // 其他模型走阿里云万相\n    return { target: 'aliyun' };\n  }\n}",
        "inputFields": [
          {
            "key": "model",
            "type": "string",
            "value": "{{ __data__[\"node_1781681576137_start\"].model }}",
            "required": true,
            "children": []
