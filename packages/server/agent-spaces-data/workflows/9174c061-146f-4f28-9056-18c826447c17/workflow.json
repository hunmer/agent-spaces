      "data": {
        "code": "async function main({ params, context }) {\n  const raw = String(params.reviewResult || '');\n  let review = null;\n  let parseError = null;\n  try {\n    const cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n    const first = cleaned.indexOf('{');\n    const last = cleaned.lastIndexOf('}');\n    const jsonText = first >= 0 && last > first ? cleaned.slice(first, last + 1) : cleaned;\n    review = JSON.parse(jsonText);\n  } catch (e) {\n    parseError = String(e && e.message ? e.message : e);\n    review = { overall: 0, dimensions: {}, strengths: [], weaknesses: [], suggestions: [], risk_flags: ['parse_failed'] };\n  }\n  const suggestions = Array.isArray(review.suggestions) ? review.suggestions : [];\n  const suggestionsText = suggestions\n    .map((s, i) => (i + 1) + '. [' + (s.target_section || '未指定段落') + '] ' + (s.rewrite_hint || ''))\n    .join('\\n');\n  context.collaboration = context.collaboration || {};\n  context.collaboration.stage = 'review';\n  context.collaboration.review = review;\n  context.collaboration.log = context.collaboration.log || [];\n  context.collaboration.log.push({\n    stage: 'review',\n    at: Date.now(),\n    agent: 'agent_content_reviewer',\n    status: parseError ? 'parse_fallback' : 'ok',\n    overall: review.overall || 0,\n    suggestions: suggestions.length\n  });\n  return {\n    review: review,\n    suggestionsText: suggestionsText,\n    suggestionsCount: suggestions.length,\n    draftText: String(params.draftText || ''),\n    pickedTopic: (context.collaboration && context.collaboration.pickedTopic) || { title: '未识别' },\n    stage: 'review',\n    parseError: parseError,\n    collaborationLog: context.collaboration.log\n  };\n}",
