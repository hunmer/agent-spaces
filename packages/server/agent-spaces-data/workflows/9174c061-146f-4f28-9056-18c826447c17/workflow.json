        "agent": {
          "id": "agent_topic_planner",
          "name": "选题策划专家",
          "role": "agent",
          "description": "负责基于议题拆解出多个角度的选题方案",
          "runtimeKind": "claude-code",
          "modelProvider": "anthropic-messages",
          "providerId": "4f3b97d8-0b26-4964-9307-58618588eefc",
          "modelId": "GLM-5.1",
          "systemPrompt": "你是一位资深内容策划专家，擅长从宏观议题中拆解出有传播力和深度的选题。请基于给定议题提出 3 个差异化的选题角度，每个角度都要包含：1) 选题标题；2) 目标读者画像；3) 核心论点；4) 预期情绪价值。最终以严格 JSON 格式输出，不要包含任何额外解释。",
          "enabled": true
        },
        "prompt": "本次议题是：{{ __data__[\"start_1782801818518\"].topic }}。请基于该议题输出 3 个差异化选题方案，严格以 JSON 数组返回。"
      }
