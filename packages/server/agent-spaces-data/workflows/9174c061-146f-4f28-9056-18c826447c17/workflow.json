        "code": "async function main({ params, context }) {\n  const draft = String(params.draftResult || '').trim();\n  const topicTitle = String(params.pickedTopicTitle || '未识别选题');\n  const pickedTopic = (context.collaboration && context.collaboration.pickedTopic) || { title: topicTitle };\n  context.collaboration = context.collaboration || {};\n  context.collaboration.stage = 'draft';\n  context.collaboration.draft = draft;\n  context.collaboration.log = context.collaboration.log || [];\n  context.collaboration.log.push({\n    stage: 'draft',\n    at: Date.now(),\n    agent: 'agent_content_writer',\n    status: draft.length > 200 ? 'ok' : 'too_short',\n    length: draft.length\n  });\n  return {\n    draftText: draft,\n    pickedTopic: pickedTopic,\n    stage: 'draft',\n    draftStats: {\n      length: draft.length,\n      paragraphs: draft.split(/\\n+/).filter(Boolean).length,\n      tooShort: draft.length < 200\n    },\n    collaborationLog: context.collaboration.log\n  };\n}",
