    {
      "id": "node_1782802129320_6z6lvi",
      "type": "run_code",
      "label": "Channel-1 状态同步",
      "position": {
        "x": 660.000280233872,
        "y": 501.09295693814227
      },
      "data": {
        "code": "async function main({ params, context }) {\n  const raw = String(params.agentResult || '');\n  let topics = [];\n  let parseError = null;\n  try {\n    const cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n    const firstBracket = cleaned.indexOf('[');\n    const lastBracket = cleaned.lastIndexOf(']');\n    const jsonText = firstBracket >= 0 && lastBracket > firstBracket ? cleaned.slice(firstBracket, lastBracket + 1) : cleaned;\n    topics = JSON.parse(jsonText);\n    if (!Array.isArray(topics)) topics = [topics];\n  } catch (e) {\n    parseError = String(e && e.message ? e.message : e);\n    topics = [{ title: '默认选题-待人工兜底', audience: '通用', thesis: raw.slice(0, 200), emotion: '中性' }];\n  }\n  const scored = topics.map((t, i) => ({\n    index: i,\n    title: t.title || ('选题' + (i + 1)),\n    audience: t.audience || '',\n    thesis: t.thesis || '',\n    emotion: t.emotion || '',\n    score: typeof t.score === 'number' ? t.score : 7 + (i === 0 ? 1 : 0)\n  }));\n  scored.sort((a, b) => b.score - a.score);\n  const picked = scored[0];\n  context.collaboration = context.collaboration || {};\n  context.collaboration.stage = 'topic';\n  context.collaboration.topicCandidates = scored;\n  context.collaboration.pickedTopic = picked;\n  context.collaboration.log = context.collaboration.log || [];\n  context.collaboration.log.push({ stage: 'topic', at: Date.now(), agent: 'agent_topic_planner', status: parseError ? 'parse_fallback' : 'ok', picked: picked.title });\n  return {\n    pickedTopic: picked,\n    topicCandidates: scored,\n    topicRaw: raw,\n    stage: 'topic',\n    collaborationLog: context.collaboration.log\n  };\n}",
        "inputFields": [
