    {
      "id": "node_1782643507770_iv31kl",
      "type": "run_code",
      "label": "解析审核结果",
      "position": {
        "x": 1540,
        "y": 220
      },
      "data": {
        "code": "async function main({ params }) {\n  const reviewText = params.reviewResult || '';\n  const firstLine = reviewText.trim().split('\\n')[0].toUpperCase();\n  const approved = firstLine.includes('APPROVED') && !firstLine.includes('NEEDS_REVISION');\n  \n  return {\n    verdict: approved ? 'approved' : 'needs_revision',\n    isApproved: approved\n  };\n}",
        "inputFields": [
          {
            "key": "reviewResult",
            "type": "string",
            "value": "{{ __data__[\"node_1782643507770_cudu51\"].result }}",
            "required": true
          }
        ],
        "outputs": [
