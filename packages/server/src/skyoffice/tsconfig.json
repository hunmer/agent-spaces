{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "../../dist/skyoffice",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "strictNullChecks": false,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["examples/**/*", "node_modules", "types/KeyboardState.ts"]
}
