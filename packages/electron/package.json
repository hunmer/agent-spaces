{
  "name": "@agent-spaces/electron",
  "version": "0.0.0",
  "description": "Agent Spaces Electron 桌面壳：窗口管理、local:// 协议、桌面原生能力、全局快捷键。后端通过外部 server。",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node -e \"require('fs').writeFileSync('out/preload/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "dev": "pnpm build && ELECTRON_RENDERER_URL=http://127.0.0.1:3000 electron .",
    "start": "electron ."
  },
  "dependencies": {
    "@agent-spaces/shared": "workspace:*",
    "@electron-toolkit/utils": "^3.0.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^31.0.0",
    "typescript": "^5.5.0"
  }
}
